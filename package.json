{
  "name": "mapcompare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit",
    "lint": "oxlint && oxfmt --check && vue-tsc",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "probe-tiles": "node scripts/probe-tiles.mjs",
    "fetch-wayback": "node scripts/fetch-wayback-releases.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:preview": "pnpm build && wrangler versions upload --preview-alias preview-$(git rev-parse --short=8 HEAD)"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@geomatico/maplibre-cog-protocol": "0.10.0",
    "@vueuse/core": "^15.0.0",
    "maplibre-gl": "^6.16.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.3",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "^4.3.4",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.157.0"
  },
  "packageManager": "pnpm@12.16.1"
}

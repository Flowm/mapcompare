{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mapcompare",
  "compatibility_date": "2026-08-01",
  "send_metrics": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "mapcompare.frcy.org",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
